log.txt

# Environment variables. Nothing here has ever been committed — this entry
# exists so that stays true by rule rather than by luck. A key added to the
# history cannot be removed by deleting it in a later commit.
.env
.env.*
!.env.example

# Dependencies and build output. Not currently tracked; listed so a stray
# `git add .` cannot pull in thousands of files.
